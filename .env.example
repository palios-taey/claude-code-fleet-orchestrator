# Required core connection values. These examples match the bundled local
# compose setup; the loader does not default them if omitted.
ORCH_REDIS_HOST=127.0.0.1
ORCH_REDIS_PORT=6379

# Fleet-notify/session-state Redis. Keep this equal to ORCH_REDIS_* unless
# you are intentionally testing split Redis configs; Stop hooks, dispatch
# current_task, idle, and liveness all use REDIS_*.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Optional Redis Sentinel support. Leave blank for a single Redis instance.
# ORCH_REDIS_SENTINELS=127.0.0.1:26379,127.0.0.1:26380
# ORCH_REDIS_SENTINEL_MASTER=orch-master

ORCH_NEO4J_URI=bolt://127.0.0.1:7687
ORCH_NEO4J_DB=neo4j

# --- Dashboard / UI network binding -----------------------------------------
# Where the dashboard + API listen. Default 127.0.0.1 = this machine only
# (safest). This localhost bind is the security boundary for the mutable API.
# Binding to any non-loopback interface is an explicit operator opt-in for a
# trusted single-user network only; never expose this API to untrusted callers.
# For cross-machine access on a trusted network, replace ORCH_HOST with the
# trusted interface address and keep ORCH_DASHBOARD_URL aligned. If you bind a
# non-loopback interface without ORCH_AUTH_TOKEN, startup fails closed unless you
# set ORCH_ALLOW_UNAUTH_NON_LOOPBACK=1 as an explicit trusted-LAN exposure
# acknowledgement. That override is not authentication; it only permits startup.
ORCH_HOST=127.0.0.1
ORCH_PORT=5002

# Optional mutable-endpoint token. Leave unset for the default loopback-only
# single-user mode. When set, POST/PUT/PATCH/DELETE requests require either
# `Authorization: Bearer <token>` or `X-API-Key: <token>`. GET/read endpoints
# remain open so the dashboard and read-only CLIs still work without headers.
# ORCH_AUTH_TOKEN=change-me-long-random-secret

# Tokenless non-loopback mutable API exposure acknowledgement. Leave unset for
# the default fail-closed posture. Set to 1 only when ORCH_HOST is a trusted LAN
# interface and you intentionally accept unauthenticated mutable API access there.
# ORCH_ALLOW_UNAUTH_NON_LOOPBACK=1

# Base URL the API/UI advertise and that hooks call. Keep host:port in sync
# with ORCH_HOST/ORCH_PORT above. Default is loopback.
ORCH_DASHBOARD_URL=http://127.0.0.1:5002

# Two-way chat box in the dashboard (talk to a session + scrollable history).
# ON by default. Chat messages become context an AI session reads (an injection
# vector), so keep the API loopback-only or use ORCH_AUTH_TOKEN on a trusted LAN.
# Set to 0 only when you intentionally want to hide the chat route.
# ORCH_CHAT_ENABLED=0

# Public read-only dashboard visibility. Shows only approved sessions; hide
# values subtract from show values, and project IDs are a hard backstop.
# Replace the placeholders with your own session/project names.
ORCH_PUBLIC_SHOW_SESSIONS=supervisor,worker-codex,worker-gemini
ORCH_PUBLIC_HIDE_SESSIONS=
ORCH_PUBLIC_HIDE_PROJECT_IDS=

# Optional explicit tasks API base for hook subprocesses.
# ORCH_API_BASE=http://127.0.0.1:5002

# Optional path to a local claude-code-fleet-notify checkout when the
# `identity` module is not already importable in the current environment.
# Set this when fleet-notify is cloned beside, rather than installed into, the
# same virtualenv as fleet-orchestrator.
# ORCH_NOTIFY_LIB_ROOT=/absolute/path/to/claude-code-fleet-notify

# Optional override for the notify CLI used by dispatch and orch-watch.
# ORCH_NOTIFY_CLI=taey-notify

# Optional for plan/source refs. Leave unset to disable refs fail-safe. Single
# path or comma-separated list of trusted roots under which plan source files must live.
# ORCH_REF_ALLOWED_ROOT=/absolute/path/to/plans,/absolute/path/to/repo/plans

# Wake-packet context endpoint. ON by default; set to 0 only to hide
# GET /api/sessions/{session}/wake-packet. Deprecated alias still honored:
# ORCH_WAKE_PACKET_ENABLED.
# ORCH_WAKE_PACKET_ENDPOINT_ENABLED=0

# Optional session allowlist for the browser notify form. Leave unset to allow
# any non-empty session id.
# ORCH_SESSION_IDS=supervisor,worker-a,worker-b

# Session -> repo-root map used by the context assembler to find each session's
# MEMORY.md / repo rules. JSON or comma-separated key=value. Unset -> assembler
# uses MEMORY_BASE only (no repo-root context). Set this to YOUR sessions' repos.
# ORCH_SESSION_ROOTS={"supervisor":"/home/me/my-repo","worker-a":"/home/me/worker-a"}
# ORCH_SESSION_ROOTS=supervisor=/home/me/my-repo,worker-a=/home/me/worker-a

# Optional session-to-product map for bug-lock enforcement in dispatch.
# Accepts JSON or comma-separated key=value pairs.
# ORCH_PRODUCT_OWNER_MAP={"supervisor":"product-id"}
# ORCH_PRODUCT_OWNER_MAP=supervisor=product-id,worker-a=other-product

# Shippability gates — which task-id SUFFIXES must be completed before a project
# can be marked shippable (POST /api/projects/{id}/ship). Comma-separated.
# Fail-closed: a plan with no matching gate tasks can never ship, so this is not
# optional. Default below is the reference operator's standard (real production
# test + full-code audit); replace with your own, e.g. ORCH_SHIP_GATES=-ci,-review.
ORCH_SHIP_GATES=-prodtest,-audit
