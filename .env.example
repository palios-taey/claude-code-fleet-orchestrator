ORCH_REDIS_HOST=127.0.0.1
ORCH_REDIS_PORT=6379

# Optional Redis Sentinel support. Leave blank for a single Redis instance.
# ORCH_REDIS_SENTINELS=127.0.0.1:26379,127.0.0.1:26380
# ORCH_REDIS_SENTINEL_MASTER=orch-master

ORCH_NEO4J_URI=bolt://127.0.0.1:7687
ORCH_NEO4J_DB=neo4j
# ORCH_NEO4J_USER=neo4j
# ORCH_NEO4J_PASS=change-me

ORCH_DASHBOARD_URL=http://127.0.0.1:5002

# Public read-only dashboard visibility. Shows only approved sessions; hide
# values subtract from show values, and project IDs are a hard backstop.
ORCH_PUBLIC_SHOW_SESSIONS=conductor,weaver,tutor,infra,hunter,taey-ed
ORCH_PUBLIC_HIDE_SESSIONS=taeys-hands,x-claude,treasurer
ORCH_PUBLIC_HIDE_PROJECT_IDS=taeys-hands-v1,treasurer-revenue,x-claude,x-claude-cycle,x-claude-scout-engagement

# Optional explicit tasks API base for hook subprocesses.
# ORCH_API_BASE=http://127.0.0.1:5002

# Optional path to a local claude-code-fleet-notify checkout when the
# `identity` module is not already importable in the current environment.
# ORCH_NOTIFY_LIB_ROOT=/absolute/path/to/claude-code-fleet-notify

# Optional override for the notify CLI used by dispatch and orch-watch.
# ORCH_NOTIFY_CLI=taey-notify

# Required for plan/source refs. Single path or comma-separated list of trusted
# roots under which plan source files must live.
# ORCH_REF_ALLOWED_ROOT=/absolute/path/to/plans,/absolute/path/to/repo/plans

# Optional session allowlist for the browser notify form. Leave unset to allow
# any non-empty session id.
# ORCH_SESSION_IDS=supervisor,worker-a,worker-b

# Optional session-to-product map for bug-lock enforcement in dispatch.
# Accepts JSON or comma-separated key=value pairs.
# ORCH_PRODUCT_OWNER_MAP={"supervisor":"product-id"}
# ORCH_PRODUCT_OWNER_MAP=supervisor=product-id,worker-a=other-product
