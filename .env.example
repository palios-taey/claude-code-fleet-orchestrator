# Deployment config for the orchestration stack.
# Copy to .env and fill in for your environment. .env is gitignored because it
# holds internal hosts and credentials. The runtime fails loud on missing
# Neo4j config, so set every value explicitly here or in the process
# environment.

# Redis (task queue, notification inbox/flags, pipeline state)
export ORCH_REDIS_HOST=127.0.0.1
export ORCH_REDIS_PORT=6379
# Optional Redis Sentinel HA (leave commented for a single instance)
# export ORCH_REDIS_SENTINELS=127.0.0.1:26379,127.0.0.1:26379,127.0.0.1:26379
# export ORCH_REDIS_SENTINEL_MASTER=orch-master

# Neo4j (project/task graph, conversation history)
export ORCH_NEO4J_URI=bolt://neo4j-host:7687
export ORCH_NEO4J_USER=neo4j
export ORCH_NEO4J_PASS=change-me
# export ORCH_NEO4J_NOAUTH=1   # only for explicit no-auth Neo4j deployments
export ORCH_NEO4J_DB=neo4j

# Dashboard / tasks API base URL
export ORCH_DASHBOARD_URL=http://localhost:5002

# This conductor session's agent id
export ORCH_CONDUCTOR_AGENT_ID=conductor

# Default host for dispatched work
export ORCH_DEFAULT_HOST=127.0.0.1

# Deploy descriptor files (paths to your agent/session/service/node JSON)
export ORCH_AGENT_PROFILES_FILE=/path/to/deploy/agents.json
export ORCH_AGENT_SESSIONS_FILE=/path/to/deploy/sessions.json
export ORCH_SIDECAR_AGENTS_FILE=/path/to/deploy/sidecars.json
export ORCH_SERVICES_FILE=/path/to/deploy/services.json
export ORCH_NODES_FILE=/path/to/deploy/nodes.json

# Memory/retrieval API
export ORCH_MEMORY_API=http://127.0.0.1:8095

# SSH targets for remote worker nodes (user@host)
export ORCH_SSH_WORKER1=user@127.0.0.1
export ORCH_SSH_WORKER2=user@127.0.0.1
