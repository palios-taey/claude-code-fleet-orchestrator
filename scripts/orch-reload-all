#!/usr/bin/env python3
"""orch-reload-all — re-ingest projects from source under project-scoped identity, SAFELY.

Why: task/phase identity became PROJECT-SCOPED (<project>::<id>, lib/plan_loader). Data ingested under
the old GLOBAL-id model may have silently fused unrelated plans into shared nodes. The markdown is the
source of truth, so re-ingesting each project from its source under the new scoping dissolves the fusion.

SAFETY (R4 audit FINDING-3 — closes all three loss windows it named):
  * NO global wipe. We only ever touch projects that are NON-exempt AND whose source is present AND
    validates (parses + scopes cleanly). Everything else — exempt projects, missing-source, would-fail,
    and anything created concurrently after the snapshot — is LEFT UNTOUCHED (preserved legacy), never
    dropped. So there is no wipe-then-lose path and no concurrent-ingest loss.
  * FULL BACKUP before any write: the entire Orch* subgraph (nodes + rels) is dumped to a timestamped
    JSON rollback artifact, path printed, before a single delete.
  * --dry-run writes nothing and reports exactly what would migrate vs be left as legacy.
Run with the orch-watch / notify daemons PAUSED for cleanliness (single-user, but avoids churn).

Usage:
  orch-reload-all --dry-run    # report migrate-set vs left-as-legacy; write nothing
  orch-reload-all --yes        # backup -> per-project wipe+reload of the reloadable set only
"""
from __future__ import annotations

import argparse
import datetime as _dt
import json
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

from lib.config import OrchConfig, get_neo4j_driver
from lib.plan_loader import (
    load_plan_from_text, _parse_plan, scope_declared_id, validate_project_id, PlanIdError,
)

BACKUP_DIR = os.environ.get("ORCH_RELOAD_BACKUP_DIR", "/home/mira/the-conductor/accountability")


def _snapshot(cfg):
    drv = get_neo4j_driver(cfg)
    with drv.session(database=cfg.neo4j_db) as s:
        return [dict(r) for r in s.run(
            """MATCH (p:OrchProject)
               RETURN p.id AS id, p.source_path AS src, p.supervisor AS sup,
                      p.priority AS pri, p.migration_exempt AS exempt ORDER BY p.id""")]


def _dry_validate(md: str):
    parsed = _parse_plan(md)
    proj = parsed.get("project")
    if proj is None:
        return False, "no '# Project:' header"
    try:
        pid = validate_project_id(proj["id"])
        for ph in parsed.get("phases", []):
            scope_declared_id(pid, ph["id"])
            for t in ph.get("tasks", []):
                scope_declared_id(pid, t["id"])
        return True, "ok"
    except PlanIdError as e:
        return False, f"PlanIdError: {e}"


def _backup(cfg) -> str:
    """Dump the whole Orch* subgraph (nodes + rels) to a timestamped JSON rollback artifact."""
    drv = get_neo4j_driver(cfg)
    os.makedirs(BACKUP_DIR, exist_ok=True)
    path = os.path.join(BACKUP_DIR, f"orch-reload-backup-{_dt.datetime.now(_dt.timezone.utc):%Y%m%dT%H%M%SZ}.json")
    with drv.session(database=cfg.neo4j_db) as s:
        nodes = [{"labels": r["labels"], "props": r["props"]} for r in s.run(
            "MATCH (n) WHERE n:OrchProject OR n:OrchPhase OR n:OrchTask "
            "RETURN labels(n) AS labels, properties(n) AS props")]
        rels = [{"type": r["t"], "start": r["a"], "end": r["b"]} for r in s.run(
            "MATCH (a)-[r]->(b) WHERE (a:OrchProject OR a:OrchPhase OR a:OrchTask) "
            "AND (b:OrchProject OR b:OrchPhase OR b:OrchTask) "
            "RETURN type(r) AS t, a.id AS a, b.id AS b")]
    with open(path, "w", encoding="utf-8") as f:
        json.dump({"nodes": nodes, "rels": rels}, f)
    return path


def _wipe_projects(cfg, project_ids):
    """Delete ONLY the named projects' subgraphs (project + its phases + its tasks). Never global."""
    drv = get_neo4j_driver(cfg)
    with drv.session(database=cfg.neo4j_db) as s:
        s.run(
            """UNWIND $pids AS pid
               MATCH (p:OrchProject {id: pid})
               OPTIONAL MATCH (p)-[:HAS_PHASE]->(ph:OrchPhase)
               OPTIONAL MATCH (ph)-[:HAS_TASK]->(t:OrchTask)
               DETACH DELETE t, ph, p""",
            pids=list(project_ids),
        )


def main() -> int:
    ap = argparse.ArgumentParser(description="Re-ingest projects from source under project-scoped identity.")
    ap.add_argument("--dry-run", action="store_true", help="report only; write nothing")
    ap.add_argument("--yes", action="store_true", help="backup, then per-project wipe + reload the reloadable set")
    args = ap.parse_args()

    cfg = OrchConfig()
    projects = _snapshot(cfg)

    exempt, reloadable, legacy = [], [], []  # legacy = left untouched (missing/would-fail)
    for p in projects:
        if p.get("exempt"):
            exempt.append(p["id"]); continue
        src = p.get("src")
        if not (src and os.path.isfile(src)):
            legacy.append((p["id"], "missing-source")); continue
        with open(src, encoding="utf-8") as f:
            ok, why = _dry_validate(f.read())
        (reloadable if ok else legacy).append(p if ok else (p["id"], why))

    print(f"projects: {len(projects)}  -> migrate(reloadable): {len(reloadable)}  "
          f"left-as-legacy: {len(legacy)}  exempt(preserved): {len(exempt)}")
    for pid in exempt:
        print(f"  EXEMPT(preserved)  {pid}")
    for pid, why in legacy:
        print(f"  LEFT-AS-LEGACY     {pid}  ({why})")

    if args.dry_run or not args.yes:
        print("\n[dry-run] nothing written. Only the migrate(reloadable) set above would be wiped+reloaded; "
              "everything else is preserved untouched. Re-run with --yes to apply.")
        return 0

    backup = _backup(cfg)
    print(f"\nbackup written: {backup}")
    ids = [p["id"] for p in reloadable]
    _wipe_projects(cfg, ids)
    ok_n, failed = 0, []
    for p in reloadable:
        try:
            with open(p["src"], encoding="utf-8") as f:
                md = f.read()
            load_plan_from_text(
                md=md, source_path=p["src"], source_kind="markdown", ingested_by="orch-reload-all",
                supervisor=p.get("sup") or "conductor", priority=p.get("pri"),
                migration_exempt=bool(p.get("exempt")), config=cfg,
            )
            ok_n += 1
        except Exception as e:  # validated pre-wipe; if it still fails, the backup is the rollback
            failed.append((p["id"], f"{type(e).__name__}: {e}"))

    print(f"\nmigrated OK: {ok_n}   failed: {len(failed)}   preserved(exempt+legacy): {len(exempt)+len(legacy)}")
    for pid, why in failed:
        print(f"  FAILED {pid}: {why}  (restore from backup: {backup})")
    return 1 if failed else 0


if __name__ == "__main__":
    raise SystemExit(main())
