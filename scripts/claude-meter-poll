#!/usr/bin/env python3
# Linux Claude usage poller. Endpoint behavior credited to m13v/claude-meter.

from __future__ import annotations

import argparse
import json
import os
import sys
import time
import urllib.error
import urllib.request
from pathlib import Path
from typing import Any, Dict, Optional


OAUTH_ENDPOINT = "https://api.anthropic.com/api/oauth/usage"
WEB_ENDPOINT_TEMPLATE = "https://claude.ai/api/organizations/{org_id}/usage"


def main() -> int:
    parser = argparse.ArgumentParser(description="Poll Claude usage for dashboard tiles")
    parser.add_argument("--json", action="store_true", help="emit JSON")
    parser.add_argument("--endpoint", default=os.environ.get("CLAUDE_USAGE_ENDPOINT"))
    parser.add_argument("--timeout", type=float, default=float(os.environ.get("CLAUDE_USAGE_TIMEOUT", "10")))
    args = parser.parse_args()

    try:
        payload = poll_usage(endpoint=args.endpoint, timeout=args.timeout)
        output = {
            "ok": True,
            "polled_at": int(time.time()),
            "source": payload["source"],
            "five_hour": _find_bucket(payload["raw"], ("five_hour", "fiveHour", "5h")),
            "weekly": _find_bucket(payload["raw"], ("weekly", "week", "7d", "seven_day", "sevenDay")),
            "raw": payload["raw"],
        }
        print(json.dumps(output, sort_keys=True))
        return 0
    except Exception as exc:
        output = {
            "ok": False,
            "polled_at": int(time.time()),
            "error": str(exc),
        }
        print(json.dumps(output, sort_keys=True), file=sys.stderr)
        return 1


def poll_usage(endpoint: Optional[str] = None, timeout: float = 10) -> Dict[str, Any]:
    if endpoint:
        headers = _headers_for_endpoint(endpoint)
        return {"source": endpoint, "raw": _get_json(endpoint, headers, timeout)}

    token = _oauth_token()
    if token:
        headers = {
            "Authorization": f"Bearer {token}",
            "anthropic-beta": "oauth-2025-04-20",
            "Accept": "application/json",
        }
        return {"source": OAUTH_ENDPOINT, "raw": _get_json(OAUTH_ENDPOINT, headers, timeout)}

    org_id = os.environ.get("CLAUDE_ORG_ID")
    cookie = os.environ.get("CLAUDE_SESSION_COOKIE") or os.environ.get("CLAUDE_COOKIE")
    if org_id and cookie:
        endpoint = WEB_ENDPOINT_TEMPLATE.format(org_id=org_id)
        headers = {
            "Cookie": cookie,
            "Accept": "application/json",
        }
        return {"source": endpoint, "raw": _get_json(endpoint, headers, timeout)}

    raise RuntimeError("set CLAUDE_ACCESS_TOKEN, CLAUDE_OAUTH_TOKEN, or CLAUDE_ORG_ID plus CLAUDE_SESSION_COOKIE")


def _headers_for_endpoint(endpoint: str) -> Dict[str, str]:
    headers = {"Accept": "application/json"}
    token = _oauth_token()
    if "api.anthropic.com" in endpoint and token:
        headers["Authorization"] = f"Bearer {token}"
        headers["anthropic-beta"] = "oauth-2025-04-20"
    cookie = os.environ.get("CLAUDE_SESSION_COOKIE") or os.environ.get("CLAUDE_COOKIE")
    if "claude.ai" in endpoint and cookie:
        headers["Cookie"] = cookie
    return headers


def _get_json(url: str, headers: Dict[str, str], timeout: float) -> Any:
    request = urllib.request.Request(url, headers=headers, method="GET")
    try:
        with urllib.request.urlopen(request, timeout=timeout) as response:
            data = response.read()
    except urllib.error.HTTPError as exc:
        body = exc.read().decode("utf-8", errors="replace")[:500]
        raise RuntimeError(f"usage endpoint returned HTTP {exc.code}: {body}") from exc
    return json.loads(data.decode("utf-8"))


def _oauth_token() -> Optional[str]:
    for name in ("CLAUDE_ACCESS_TOKEN", "CLAUDE_OAUTH_TOKEN", "ANTHROPIC_ACCESS_TOKEN"):
        value = os.environ.get(name)
        if value:
            return value.strip()
    credentials_path = Path(os.environ.get("CLAUDE_CREDENTIALS_PATH", Path.home() / ".claude" / ".credentials.json"))
    if not credentials_path.is_file():
        return None
    data = json.loads(credentials_path.read_text(encoding="utf-8"))
    return _find_token(data)


def _find_token(value: Any) -> Optional[str]:
    if isinstance(value, dict):
        for key in ("access_token", "accessToken", "oauth_token", "token"):
            token = value.get(key)
            if isinstance(token, str) and token.strip():
                return token.strip()
        for nested in value.values():
            token = _find_token(nested)
            if token:
                return token
    if isinstance(value, list):
        for item in value:
            token = _find_token(item)
            if token:
                return token
    return None


def _find_bucket(value: Any, names: tuple[str, ...]) -> Any:
    if isinstance(value, dict):
        lowered = {str(key).lower(): key for key in value}
        for name in names:
            key = lowered.get(name.lower())
            if key is not None:
                return value[key]
        for nested in value.values():
            found = _find_bucket(nested, names)
            if found is not None:
                return found
    if isinstance(value, list):
        for item in value:
            found = _find_bucket(item, names)
            if found is not None:
                return found
    return None


if __name__ == "__main__":
    raise SystemExit(main())
