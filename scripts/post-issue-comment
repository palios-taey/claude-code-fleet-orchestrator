#!/usr/bin/env python3
"""Post a GitHub issue/PR comment under live outward authorization.

P0 safety (task-f396305d): requires a live current_task binding for --session
(or ORCH_OUTWARD_SESSION / tmux session). Unbind/revocation denies mutation even
if the worker process is still running. This is the comment-side counterpart of
scripts/post-audit-status — the observed incident was a stale PR comment after
unbind.
"""
from __future__ import annotations

import argparse
import json
import subprocess
import sys
from pathlib import Path
from typing import Any

ROOT = Path(__file__).resolve().parents[1]
if str(ROOT) not in sys.path:
    sys.path.insert(0, str(ROOT))

from fleet_orchestrator.outward_capability import (  # noqa: E402
    OutwardAuthorizationError,
    post_issue_comment,
    resolve_session_id,
)


def _run_gh_api(args: list[str]) -> Any:
    result = subprocess.run(
        ["gh", "api", *args],
        capture_output=True,
        text=True,
        check=False,
    )
    if result.returncode != 0:
        detail = (result.stderr or result.stdout).strip()
        raise RuntimeError(f"gh api failed: {detail}")
    try:
        return json.loads(result.stdout or "null")
    except json.JSONDecodeError as exc:
        raise RuntimeError(f"gh api returned invalid JSON: {exc}") from exc


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Post a GitHub issue/PR comment under live outward authorization."
    )
    parser.add_argument("--repo", required=True, help="GitHub repository as OWNER/REPO")
    parser.add_argument("--issue", required=True, type=int, help="Issue or PR number")
    parser.add_argument("--body", required=True, help="Comment body")
    parser.add_argument(
        "--session",
        help="Worker session for live current_task authorization (default: ORCH_OUTWARD_SESSION / tmux #S)",
    )
    args = parser.parse_args()

    session = resolve_session_id(args.session)
    if not session:
        print(
            "SAFETY DENY: --session (or ORCH_OUTWARD_SESSION / tmux session) is required "
            "for outward GitHub comment mutation",
            file=sys.stderr,
        )
        return 1

    try:
        posted = post_issue_comment(
            session_id=session,
            repo=args.repo,
            issue_number=args.issue,
            body=args.body,
            gh_api=_run_gh_api,
        )
    except OutwardAuthorizationError as exc:
        print(f"SAFETY DENY: {exc}", file=sys.stderr)
        return 1
    except Exception as exc:  # noqa: BLE001
        print(f"COMMENT POST FAILED: {exc}", file=sys.stderr)
        return 1

    print(
        "COMMENT POST VERIFIED "
        f"repo={args.repo} issue={args.issue} session={session} id={posted.get('id')}"
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
