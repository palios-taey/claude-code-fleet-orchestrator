#!/usr/bin/env python3
"""orch-gate-run — clean-room verification gate (ANTIFAB P1).

Usage:
  orch-gate-run <task> <sha> --assert '<live-read cmd, exit 0 == change is observable>'
                             [--clean '<setup cmd>'] [--boot '<start cmd>'] [--repo <path>]

Runs the gate in a fresh detached checkout of <sha>, derives PASS/FAIL/INDETERMINATE from what it
observed, and appends a gate_run row to the accountability ledger. The builder never reports the result.
Exit code: 0 on PASS, 1 on FAIL, 2 on INDETERMINATE.
"""
import argparse
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))

from lib.gate_runner import DEFAULT_REPO, run_gate


def main() -> int:
    ap = argparse.ArgumentParser(description="Clean-room verification gate runner (ANTIFAB P1)")
    ap.add_argument("task")
    ap.add_argument("sha")
    ap.add_argument("--assert", dest="assert_cmd", default=None,
                    help="production oracle: a live read-after-write that exits 0 iff the change is observable")
    ap.add_argument("--clean", default=None, help="setup cmd run in the fresh worktree (e.g. pip install -e .)")
    ap.add_argument("--boot", default=None, help="cmd that starts the component (or omit)")
    ap.add_argument("--repo", default=DEFAULT_REPO)
    ap.add_argument("--timeout", type=int, default=600)
    args = ap.parse_args()

    verdict = run_gate(args.task, args.sha, clean=args.clean, boot=args.boot,
                       assert_cmd=args.assert_cmd, repo=args.repo, timeout=args.timeout)
    print(json.dumps(verdict, indent=2))
    return {"PASS": 0, "FAIL": 1, "INDETERMINATE": 2}.get(verdict["result"], 1)


if __name__ == "__main__":
    raise SystemExit(main())
