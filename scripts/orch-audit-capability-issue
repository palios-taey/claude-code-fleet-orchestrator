#!/usr/bin/env python3
"""Mechanical client for distinct-UID supervisor capability issuance.

Run as a uid listed in ORCH_AUDIT_CAPABILITY_UID_MAP and a member of
orch-audit-clients (SocketGroup). Peercred uid is the principal; ORCH_SESSION_ID
environ is ignored.

Example:
  sudo -u orch-sup-conductor \\
    ORCH_AUDIT_CAPABILITY_SOCKET=/var/lib/fleet-orchestrator/audit-capability/issuer.sock \\
    orch-audit-capability-issue --task-id task-abc --action pin-audit-contract
"""
from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
if str(ROOT) not in sys.path:
    sys.path.insert(0, str(ROOT))

from fleet_orchestrator.audit_capability_issuer import issue_audit_capability  # noqa: E402
from fleet_orchestrator.audit_completion import AuditContractError  # noqa: E402


def main() -> int:
    parser = argparse.ArgumentParser(description="Issue X-Orch-Audit-Capability via peercred uid")
    parser.add_argument("--task-id", required=True)
    parser.add_argument(
        "--action",
        required=True,
        choices=("pin-audit-contract", "bind-audit-status"),
    )
    parser.add_argument("--socket", default="", help="Issuer unix socket path")
    parser.add_argument("--ttl-sec", type=int, default=300)
    parser.add_argument("--json", action="store_true", help="Print full issuer JSON response")
    args = parser.parse_args()
    try:
        result = issue_audit_capability(
            task_id=args.task_id,
            action=args.action,
            ttl_sec=args.ttl_sec,
            socket_path=Path(args.socket) if args.socket else None,
        )
    except AuditContractError as exc:
        print(f"ERROR: {exc}", file=sys.stderr)
        return 2
    if args.json:
        print(json.dumps(result, sort_keys=True))
    else:
        print(result["capability"])
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
