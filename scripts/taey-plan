#!/usr/bin/env python3
"""
Inspect and ingest execution-tracker projects via the tasks API.

Usage:
    taey-plan list
    taey-plan show execution-tracker-v1
    taey-plan current
    taey-plan next [session]
    taey-plan ingest /path/to/plan.md
    taey-plan assign <task-id> <session>
    taey-plan stop-conditions <project-id> get
    taey-plan stop-conditions <project-id> set <condition> [<condition> ...]
"""
from __future__ import annotations

import argparse
import hashlib
import json
import os
import socket
import subprocess
import sys
import urllib.error
import urllib.request
from pathlib import Path
from typing import Any, Dict, Iterable, List


API_URL = os.environ.get("ORCH_DASHBOARD_URL", "http://localhost:5002")


def detect_session() -> str:
    explicit = os.environ.get("TAEY_NODE_ID")
    if explicit:
        return explicit
    try:
        result = subprocess.run(
            ["tmux", "display-message", "-p", "#S"],
            capture_output=True,
            text=True,
            timeout=2,
        )
        if result.returncode == 0 and result.stdout.strip():
            return result.stdout.strip()
    except Exception:
        pass
    return socket.gethostname()


def api_call(method: str, endpoint: str, data: Dict[str, Any] | None = None) -> Dict[str, Any]:
    url = f"{API_URL}{endpoint}"
    if data is None:
        request = urllib.request.Request(url, method=method)
    else:
        request = urllib.request.Request(
            url,
            data=json.dumps(data).encode(),
            headers={"Content-Type": "application/json"},
            method=method,
        )
    try:
        with urllib.request.urlopen(request, timeout=20) as response:
            return json.loads(response.read().decode())
    except urllib.error.HTTPError as exc:
        body = exc.read().decode()[:800]
        print(f"ERROR: HTTP {exc.code}: {body}", file=sys.stderr)
        sys.exit(1)
    except Exception as exc:
        print(f"ERROR: {exc}", file=sys.stderr)
        sys.exit(1)


def truncate(text: str, width: int) -> str:
    clean = " ".join((text or "").split())
    if len(clean) <= width:
        return clean
    return clean[: max(0, width - 1)] + "…"


def print_table(headers: List[str], rows: Iterable[Iterable[Any]]) -> None:
    row_list = [[str(cell) for cell in row] for row in rows]
    widths = [len(header) for header in headers]
    for row in row_list:
        for idx, cell in enumerate(row):
            widths[idx] = max(widths[idx], len(cell))

    print("  ".join(header.ljust(widths[idx]) for idx, header in enumerate(headers)))
    print("  ".join("-" * widths[idx] for idx in range(len(headers))))
    for row in row_list:
        print("  ".join(cell.ljust(widths[idx]) for idx, cell in enumerate(row)))


def detect_kind(path: Path) -> str:
    lower = str(path).lower()
    if "consultations" in lower:
        return "consultation"
    if path.suffix.lower() == ".md":
        return "markdown"
    return "markdown"


def cmd_list(_: argparse.Namespace) -> None:
    result = api_call("GET", "/api/projects")
    projects = result.get("projects", [])
    if not projects:
        print("No projects.")
        return
    rows = []
    for project in projects:
        rows.append([
            project.get("id", ""),
            project.get("phase_count", 0),
            project.get("task_total", 0),
            project.get("pending", 0),
            project.get("in_progress", 0),
            project.get("completed", 0),
            project.get("failed", 0),
            truncate(project.get("name", ""), 40),
        ])
    print(f"projects: {len(projects)}")
    print_table(
        ["ID", "Ph", "Tasks", "Pend", "Doing", "Done", "Fail", "Name"],
        rows,
    )


def cmd_show(args: argparse.Namespace) -> None:
    result = api_call("GET", f"/api/projects/{args.project_id}")
    project = result.get("project", {})
    phases = result.get("phases", [])
    total_tasks = sum((phase.get("task_counts") or {}).get("total", 0) for phase in phases)

    print(f"Project: {project.get('name', args.project_id)}")
    print(f"ID: {project.get('id', args.project_id)}")
    print(f"Description: {project.get('description', '')}")
    print(f"Phases: {len(phases)} / Tasks: {total_tasks}")
    if project.get("source_path"):
        print(f"Source: {project['source_path']} [{project.get('source_kind', 'unknown')}]")
    print("")

    if not phases:
        print("No phases.")
        return

    rows = []
    for item in phases:
        phase = item.get("phase", {})
        counts = item.get("task_counts", {})
        rows.append([
            phase.get("order", 0),
            phase.get("id", ""),
            truncate(phase.get("name", ""), 32),
            counts.get("total", 0),
            counts.get("pending", 0),
            counts.get("in_progress", 0),
            counts.get("completed", 0),
            counts.get("failed", 0),
        ])
    print_table(
        ["Ord", "Phase ID", "Name", "Tasks", "Pend", "Doing", "Done", "Fail"],
        rows,
    )


def cmd_current(args: argparse.Namespace) -> None:
    session = args.session or detect_session()
    result = api_call("GET", f"/api/sessions/{session}/current")
    current = result.get("current")
    if not current:
        print("no in-progress work")
        return
    print(
        f"Project: {current.get('project_name', current.get('project_id', '?'))} / "
        f"Phase: {current.get('phase_name', current.get('phase_id', '?'))} / "
        f"Current task: {current.get('top_task_id', '?')} (in_progress)"
    )


def cmd_next(args: argparse.Namespace) -> None:
    session = args.session or detect_session()
    result = api_call("GET", f"/api/sessions/{session}/next-ready")
    next_task = result.get("next")
    if not next_task:
        print("next: none")
        return
    print(
        f"next: {next_task.get('task_id', '?')} "
        f"(priority {next_task.get('priority', '?')}) - "
        f"{truncate(next_task.get('description', ''), 160)}"
    )


def cmd_ingest(args: argparse.Namespace) -> None:
    session = detect_session()
    path = Path(args.path).expanduser().resolve()
    if not path.is_file():
        print(f"ERROR: file not found: {path}", file=sys.stderr)
        sys.exit(1)

    md_text = path.read_text()
    sha256 = hashlib.sha256(md_text.encode("utf-8")).hexdigest()
    source_kind = detect_kind(path)
    supervisor = (args.supervisor or session).strip()
    payload = {
        "md_text": md_text,
        "source_path": str(path),
        "source_kind": source_kind,
        "ingested_by": session,
        "supervisor": supervisor,
        "migration_exempt": bool(args.migration_exempt),
    }
    if args.priority is not None:
        payload["priority"] = args.priority
    result = api_call("POST", "/api/projects/load-md", payload)
    print(f"project: {result.get('project_id', '?')}")
    print(f"source_kind: {source_kind}")
    print(f"source_sha256: {sha256}")
    print(
        f"phases_created={result.get('phases_created', 0)} "
        f"tasks_created={result.get('tasks_created', 0)} "
        f"tasks_updated={result.get('tasks_updated', 0)} "
        f"errors={len(result.get('errors', []))} "
        f"stale_tasks={len(result.get('stale_tasks', []))}"
    )
    if result.get("errors"):
        print("errors:")
        for item in result["errors"]:
            print(f"  - {item}")
    if result.get("warnings"):
        print("warnings:")
        for item in result["warnings"]:
            print(f"  - {item}")
    if result.get("stale_tasks"):
        print("stale_tasks:")
        for item in result["stale_tasks"]:
            print(f"  - {item}")


def cmd_assign(args: argparse.Namespace) -> None:
    task = api_call("GET", f"/api/tasks/{args.task_id}")
    status = task.get("status", "pending")
    payload = {
        "owner": args.session,
        "status": status,
    }
    result = api_call("PATCH", f"/api/task/{args.task_id}", payload)
    if not result.get("ok"):
        print(f"ERROR: {result.get('error', 'unknown error')}", file=sys.stderr)
        sys.exit(1)
    print(f"OK: {args.task_id} assigned to {args.session} [{status}]")


def cmd_stop_conditions_get(args: argparse.Namespace) -> None:
    result = api_call("GET", f"/api/projects/{args.project_id}/user-stop-conditions")
    print(json.dumps(result, indent=2))


def cmd_stop_conditions_set(args: argparse.Namespace) -> None:
    result = api_call(
        "POST",
        f"/api/projects/{args.project_id}/user-stop-conditions",
        {"conditions": args.conditions},
    )
    print(json.dumps(result, indent=2))


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        description="Inspect and ingest execution-tracker projects via the tasks API"
    )
    sub = parser.add_subparsers(dest="command")

    sub.add_parser("list", help="List all tracker projects")

    show = sub.add_parser("show", help="Show one project summary")
    show.add_argument("project_id", help="Project ID")

    current = sub.add_parser("current", help="Show current in-progress work")
    current.add_argument("session", nargs="?", help="Session ID (defaults to tmux session)")

    next_cmd = sub.add_parser("next", help="Show next ready task")
    next_cmd.add_argument("session", nargs="?", help="Session ID (defaults to tmux session)")

    ingest = sub.add_parser("ingest", help="Ingest a markdown plan into Neo4j")
    ingest.add_argument("path", help="Path to plan markdown")
    ingest.add_argument(
        "--supervisor",
        default=None,
        help="Session that owns this project for stop-discipline (default: current session)",
    )
    ingest.add_argument(
        "--priority",
        type=int,
        default=None,
        help="Initial project priority (lower=higher priority; default left to backend)",
    )
    ingest.add_argument(
        "--migration-exempt",
        action="store_true",
        help="Mark project as exempt from v1.3.0 stop-discipline (legacy/seed projects only)",
    )

    assign = sub.add_parser("assign", help="Assign a task to a session")
    assign.add_argument("task_id", help="Task ID")
    assign.add_argument("session", help="Session ID")

    stop_conditions = sub.add_parser("stop-conditions", help="Read or set plan-level user stop conditions")
    stop_conditions.add_argument("project_id", help="Project ID")
    stop_conditions_sub = stop_conditions.add_subparsers(dest="stop_conditions_action")

    stop_conditions_get = stop_conditions_sub.add_parser("get", help="Read stop conditions")
    stop_conditions_get.set_defaults(func=cmd_stop_conditions_get)

    stop_conditions_set = stop_conditions_sub.add_parser("set", help="Write stop conditions")
    stop_conditions_set.add_argument("conditions", nargs="+", help="Condition names to persist")
    stop_conditions_set.set_defaults(func=cmd_stop_conditions_set)

    return parser


def main() -> None:
    parser = build_parser()
    args = parser.parse_args()
    if args.command == "list":
        cmd_list(args)
    elif args.command == "show":
        cmd_show(args)
    elif args.command == "current":
        cmd_current(args)
    elif args.command == "next":
        cmd_next(args)
    elif args.command == "ingest":
        cmd_ingest(args)
    elif args.command == "assign":
        cmd_assign(args)
    elif args.command == "stop-conditions":
        if not getattr(args, "stop_conditions_action", None):
            parser.error("stop-conditions requires get or set")
        args.func(args)
    else:
        parser.print_help()


if __name__ == "__main__":
    main()
