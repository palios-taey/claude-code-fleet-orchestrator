# Distinct-UID issuer environment (/etc/fleet-orchestrator/orch-audit-capabilityd.env).
# Do NOT put private key material in the shared mira worker .env.

# Map OS uids of supervisor *client runners* → fleet session ids.
# Workers (uid 1000/mira) must NOT appear here and must NOT be in orch-audit-clients.
# Example:
#   orch-cap            — issuer daemon uid (owns private key 0600)
#   orch-sup-conductor  — conductor-codex issuance client uid (in orch-audit-clients)
ORCH_AUDIT_CAPABILITY_UID_MAP={"1001":"conductor-codex"}
ORCH_AUDIT_CAPABILITY_CLIENT_GROUP=orch-audit-clients

ORCH_AUDIT_CAPABILITY_PRIVATE_KEY_PATH=/var/lib/fleet-orchestrator/audit-capability/ed25519.private
ORCH_AUDIT_CAPABILITY_PUBLIC_KEY_PATH=/var/lib/fleet-orchestrator/audit-capability/ed25519.public
ORCH_AUDIT_CAPABILITY_SOCKET=/var/lib/fleet-orchestrator/audit-capability/issuer.sock

# API processes load ONLY the public key path (verify-only).
