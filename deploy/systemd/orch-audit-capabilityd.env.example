# Distinct-UID issuer environment (install as /etc/fleet-orchestrator/orch-audit-capabilityd.env).
# Do NOT put these in the shared mira worker .env.

# Map OS uids of supervisor *runners* to fleet session ids.
# Create user orch-sup-conductor (example uid 1001), add it to group orch-audit-sup,
# and never list the shared mira/worker uid (typically 1000).
ORCH_AUDIT_CAPABILITY_UID_MAP={"1001":"conductor-codex"}

ORCH_AUDIT_CAPABILITY_PRIVATE_KEY_PATH=/var/lib/fleet-orchestrator/audit-capability/ed25519.private
ORCH_AUDIT_CAPABILITY_PUBLIC_KEY_PATH=/var/lib/fleet-orchestrator/audit-capability/ed25519.public
ORCH_AUDIT_CAPABILITY_SOCKET=/var/lib/fleet-orchestrator/audit-capability/issuer.sock

# API / verifier processes: set ONLY the public key path. They must not receive
# the private key path or the issuer socket write credentials.
# ORCH_AUDIT_CAPABILITY_PUBLIC_KEY_PATH=/var/lib/fleet-orchestrator/audit-capability/ed25519.public
