[Unit]
Description=Fleet orchestrator audit capability issuer (distinct-UID)
Documentation=https://github.com/palios-taey/claude-code-fleet-orchestrator
After=network.target
Requires=orch-audit-capabilityd.socket

[Service]
Type=simple
# Distinct OS principal — must NOT be the shared mira/worker uid.
User=orch-cap
Group=orch-cap
UMask=0077
WorkingDirectory=/opt/claude-code-fleet-orchestrator
EnvironmentFile=-/etc/fleet-orchestrator/orch-audit-capabilityd.env
ExecStart=/opt/claude-code-fleet-orchestrator/scripts/orch-audit-capabilityd --serve
Restart=on-failure
RestartSec=2
# Private key must be owned by orch-cap mode 0600; API loads only the public key.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/fleet-orchestrator/audit-capability

[Install]
WantedBy=multi-user.target
