# Example CONTROL-deploy unit. This PR does not enable or start it.
#
# Production-viable principal split (observed live: orch API + workers are
# all uid 1000, so SO_PEERCRED uid mapping cannot distinguish them):
#   useradd --system --no-create-home github-broker
#   groupadd --system github-workers
#   groupadd --system github-control
#   # Do NOT usermod -aG github-control mira: every seat is uid mira.
#   # Only the SYSTEM unit fleet-orchestrator-api.service gets
#   # SupplementaryGroups=github-control. Control mint is that unit's
#   # cgroup (/system.slice/fleet-orchestrator-api.service), not argv.
#
# Socket modes (mechanically required; 0600 is owner-only and cannot be
# opened by uid mira even with a supplementary group). Exec and control
# use disjoint top-level runtime parents so github-control can traverse
# to the control socket without needing github-workers on any ancestor:
#   exec dir       0750 github-broker:github-workers   /run/github-broker
#   control dir    0750 github-broker:github-control   /run/github-broker-control
#   exec socket    0660 github-broker:github-workers
#   control socket 0660 github-broker:github-control
#
#   install -m 600 -o github-broker -g github-broker github-broker.env /etc/orch/github-broker.env
# Worker UIDs must not be able to read that file or exec the inner gh except via the socket.

[Unit]
Description=PALIOS GitHub outward credential broker
After=network.target

[Service]
Type=simple
User=github-broker
Group=github-broker
SupplementaryGroups=github-workers github-control
UMask=0007
EnvironmentFile=/etc/orch/github-broker.env
# EnvironmentFile must set GH_TOKEN,
# ORCH_GITHUB_BROKER_SOCKET=/run/github-broker/github-broker.sock,
# ORCH_GITHUB_BROKER_CONTROL_SOCKET=/run/github-broker-control/github-broker-control.sock,
# ORCH_GITHUB_BROKER_INNER, ORCH_GITHUB_BROKER_EXEC_GROUP=github-workers,
# ORCH_GITHUB_BROKER_CONTROL_GROUP=github-control,
# ORCH_GITHUB_BROKER_CONTROL_CGROUP=/system.slice/fleet-orchestrator-api.service.
# The broker chowns exec socket/parent to EXEC_GROUP and control
# socket/parent to CONTROL_GROUP; SupplementaryGroups does not set st_gid.
# Nested control under the exec parent is refused at broker start.
RuntimeDirectory=github-broker github-broker-control
RuntimeDirectoryMode=0750
ExecStart=/usr/bin/python3 /usr/local/lib/claude-code-fleet-orchestrator/scripts/github-brokerd
Restart=on-failure
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
