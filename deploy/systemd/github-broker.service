# Example CONTROL-deploy unit. This PR does not enable or start it.
#
# Production-viable principal split (observed live: orch API + workers are
# all uid 1000, so SO_PEERCRED uid mapping cannot distinguish them):
#   useradd --system --no-create-home github-broker
#   groupadd --system github-workers
#   groupadd --system github-control
#   # Do NOT usermod -aG github-control mira: every seat is uid mira.
#   # Only the orchestrator API unit gets SupplementaryGroups=github-control
#   # (see fleet-orchestrator-api-gatea.service). Worker tmux seats do not
#   # inherit that group. Control mint also requires the API cmdline
#   # (uvicorn + tasks_api) or a supervisor TTY.
#
# Socket modes (mechanically required; 0600 is owner-only and cannot be
# opened by uid mira even with a supplementary group):
#   exec socket    0660 github-broker:github-workers
#   control socket 0660 github-broker:github-control
#   control dir    0750 github-broker:github-control
#
#   install -m 600 -o github-broker -g github-broker github-broker.env /etc/orch/github-broker.env
# Worker UIDs must not be able to read that file or exec the inner gh except via the socket.

[Unit]
Description=PALIOS GitHub outward credential broker
After=network.target

[Service]
Type=simple
User=github-broker
Group=github-broker
SupplementaryGroups=github-workers github-control
UMask=0007
EnvironmentFile=/etc/orch/github-broker.env
# EnvironmentFile must set GH_TOKEN, ORCH_GITHUB_BROKER_SOCKET,
# ORCH_GITHUB_BROKER_CONTROL_SOCKET, ORCH_GITHUB_BROKER_INNER,
# ORCH_GITHUB_BROKER_CONTROL_UIDS, ORCH_GITHUB_BROKER_WORKER_UIDS.
ExecStart=/usr/bin/python3 /usr/local/lib/claude-code-fleet-orchestrator/scripts/github-brokerd
Restart=on-failure
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
